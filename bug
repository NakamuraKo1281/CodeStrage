import streamlit as st
from streamlit_drawable_canvas import st_canvas

st.title("ドラッグで点を移動するデモ（枠内自動補正付き）")

# キャンバスのサイズ定義
CANVAS_WIDTH = 600
CANVAS_HEIGHT = 400
RADIUS = 6

# 1. keyを動的に変更するためのカウンターを初期化
if "canvas_key_counter" not in st.session_state:
    st.session_state.canvas_key_counter = 0

# セッション状態にキャンバス データを保持する初期化処理
if "canvas_data" not in st.session_state:
    st.session_state.canvas_data = {
        "version": "4.4.0",
        "objects": [
            {
                "type": "circle",
                "left": 150,
                "top": 100,
                "radius": RADIUS,
                "fill": "red",
                "stroke": "#000",
                "strokeWidth": 1,
                "hasControls": False,
                "lockScalingX": True,
                "lockScalingY": True,
                "lockRotation": True,
                "lockSkewingX": True,
                "lockSkewingY": True,
                "lockUniScaling": True,
            },
            {
                "type": "circle",
                "left": 300,
                "top": 200,
                "radius": RADIUS,
                "fill": "blue",
                "stroke": "#000",
                "strokeWidth": 1,
                "hasControls": False,
                "lockScalingX": True,
                "lockScalingY": True,
                "lockRotation": True,
                "lockSkewingX": True,
                "lockSkewingY": True,
                "lockUniScaling": True,
            },
        ],
    }

# キャンバスを描画（keyにカウンターを埋め込み）
canvas_result = st_canvas(
    fill_color="rgba(255, 0, 0, 0.3)",
    stroke_width=3,
    stroke_color="#000",
    background_color="#fff",
    update_streamlit=True,
    height=CANVAS_HEIGHT,
    width=CANVAS_WIDTH,
    drawing_mode="transform",  # 図形の移動モード
    initial_drawing=st.session_state.canvas_data,
    key=f"canvas_{st.session_state.canvas_key_counter}",
)

# ドラッグ後の位置制限と自動修正処理
if canvas_result.json_data is not None:
    objects = canvas_result.json_data.get("objects", [])
    if objects:
        needs_rerun = False
        st.subheader("現在の座標")

        # ダブルクリック時の微小な計算ブレで再描画が走るのを防ぐ閾値(px)
        EPSILON = 1.0

        for i, obj in enumerate(objects):
            r = obj.get("radius", RADIUS)
            raw_x = obj.get("left", 0)
            raw_y = obj.get("top", 0)

            # 円が枠からはみ出さない限界値を計算（Fabric.jsの円は左上原点）
            max_x = CANVAS_WIDTH - r * 2
            max_y = CANVAS_HEIGHT - r * 2

            # 枠内に収まるように座標を制限
            clamped_x = max(0, min(raw_x, max_x))
            clamped_y = max(0, min(raw_y, max_y))

            # 枠外へのはみ出し量が閾値（1px）を超えている場合のみ再描画フラグを立てる
            if abs(raw_x - clamped_x) > EPSILON or abs(raw_y - clamped_y) > EPSILON:
                needs_rerun = True

            # セッションの元の設定データ側の座標を更新
            st.session_state.canvas_data["objects"][i]["left"] = clamped_x
            st.session_state.canvas_data["objects"][i]["top"] = clamped_y

            st.write(
                f"点 {i+1} ({obj.get('fill')}): X = {clamped_x:.1f}, Y = {clamped_y:.1f}"
            )

        # 明らかにはみ出した場合のみ、keyを変更してコンポーネントをリロード
        if needs_rerun:
            st.session_state.canvas_key_counter += 1
            st.rerun()
