import streamlit as st
from bokeh.embed import file_html
from bokeh.models import ColumnDataSource, PointDrawTool
from bokeh.plotting import figure
from bokeh.resources import CDN
import streamlit.components.v1 as components

st.title("Streamlit + Bokeh ドラッグ可能な点")

# 1. データとデータソースの準備
if "x" not in st.session_state:
    st.session_state.x = [1.0, 2.0, 3.0]
    st.session_state.y = [10.0, 20.0, 15.0]

source = ColumnDataSource(data=dict(x=st.session_state.x, y=st.session_state.y))

# 2. グラフの作成
p = figure(
    x_range=(0, 5),
    y_range=(0, 25),
    width=600,
    height=400,
    tools="",
    title="点をドラッグして動かせます",
)

# 3. 点の描画 (円)
renderer = p.circle("x", "y", source=source, size=20, color="navy", alpha=0.8)

# 4. PointDrawTool（ドラッグ機能）の有効化
draw_tool = PointDrawTool(renderers=[renderer], add=False)
p.add_tools(draw_tool)
p.toolbar.active_tap = draw_tool

# 5. BokehグラフをHTMLとしてレンダリングし、Streamlitのcomponentsで表示
html_code = file_html(p, CDN, "bokeh_plot")
components.html(html_code, height=430)
